{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{tests/**,**/test_*.py,requirements-dev.txt}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/app/main" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
